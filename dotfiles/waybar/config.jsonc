{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["custom/ip" , "network"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "custom/mic"],

    "custom/ip": {
        "exec": "ip route get 1.1.1.1 | awk '{print $7; exit}'",
        "interval": 30,
        "format": "\uf0ac  {}",
        "tooltip": false
    },

    "network": {
    "interval": 2,
    "format": "\uea9a {bandwidthDownBytes}  \ueaa1 {bandwidthUpBytes}",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "\uf4bc  {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "\uefc5  {}%",
        "interval": 5
    },

    "pulseaudio": {
        "format": "\uf028  {volume}%",
        "format-muted": "\uf026  Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "custom/mic": {
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print int($2*100)\"%\"}'",
        "interval": 5,
        "format": "\uf130  {}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip": false
    }
}
