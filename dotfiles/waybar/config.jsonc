{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["custom/ip" , "network", "cava"],
    "modules-center": ["clock"],
    "modules-right": ["keyboard-state", "cpu", "memory", "pulseaudio", "pulseaudio#mic"],

    "custom/ip": {
        "exec": "ip route get 1.1.1.1 | awk '{print $7; exit}'",
        "interval": 30,
        "format": "\uf0ac  {}",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format": "\uea9a {bandwidthDownBytes}  \ueaa1 {bandwidthUpBytes}",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "\uf4bc  {usage}%",
        "interval": 6
    },

    "memory": {
        "format": "\uefc5  {}%",
        "interval": 5
    },
    

    "cava": {
        "framerate": 60,
        "autosense": 1,
    "bars": 14,
    "method": "pipewire",
    "source": "auto",
    "bar_delimiter": 0,
    "input_delay": 0,
    "noise_reduction": 0.1,
    "hide_on_silence": false,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },
    

    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "scrolllock": false,
        "format": "{icon}",
        "format-icons": {
            "locked": "A",
            "unlocked": "a"
        }
    },

    "pulseaudio": {
        "format": "\uf485  {volume}%",
        "format-muted": "\uf466  Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "pulseaudio#mic": {
      "format": "{format_source}",
      "format-source": "\uf130  {volume}%",
      "format-source-muted": "\uf131  Muted",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
      "tooltip": false
    }
}
