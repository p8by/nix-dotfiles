{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "linux"
    },
    "display": {
        "separator": " \u279c  ",
        "color": "white"
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "cpu",
        "memory",
        {
            "type": "disk",
            "showFree": true,
            "showAvailable": true
        },
        "localip",
        "break",
//        "colors"
    ]
}
