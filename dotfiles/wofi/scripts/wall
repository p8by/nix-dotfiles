#!/usr/bin/env bash
driftwm_cfg="$HOME/nixos-dotfiles/dotfiles/driftwm/config.toml"
dir="$HOME/nixos-dotfiles/Wallpapers"
state="$HOME/.cache/current-wallpaper"
wal_sh="$HOME/.cache/wal/colors.sh"
starship_cfg="$HOME/nixos-dotfiles/dotfiles/starship/starship.toml"
thumbs="$HOME/.cache/wall-thumbs"

menu() {
	wofi --dmenu --allow-images --insensitive --cache-file /dev/null "$@"
}

thumb() {
	local src="$1" key out
	key="$(printf '%s' "$src" | md5sum | cut -d' ' -f1)-$(stat -c %Y "$src")"
	out="$thumbs/$key.png"
	if [ ! -f "$out" ]; then
		mkdir -p "$thumbs"
		magick "${src}[0]" -thumbnail 256x256^ -gravity center -extent 256x256 "$out" 2>/dev/null || return 1
	fi
	printf '%s' "$out"
}

list() {
	local rel t
	find "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%P\n' | sort |
		while IFS= read -r rel; do
			if t="$(thumb "$dir/$rel")"; then
				printf 'img:%s:text:%s\n' "$t" "$rel"
			else
				printf '%s\n' "$rel"
			fi
		done
}

starship_palette() {
	[ -f "$wal_sh" ] && [ -f "$starship_cfg" ] || return 0
	grep -q '# >>> wal palette >>>' "$starship_cfg" || return 0
	grep -q '# <<< wal palette <<<' "$starship_cfg" || return 0

	local palfile tmp
	palfile="$(mktemp)"
	tmp="$(mktemp)"

	(
		. "$wal_sh"
		printf '%s\n' \
			"[palettes.wal]" \
			"bg0 = \"$background\"" \
			"bg1 = \"$color8\"" \
			"bg2 = \"$color4\"" \
			"bg3 = \"$color12\"" \
			"fg = \"$foreground\"" \
			"accent = \"$color14\""
	) > "$palfile"

	awk -v pf="$palfile" '
		/# <<< wal palette <<</ { skip = 0 }
		!skip { print }
		/# >>> wal palette >>>/ {
			skip = 1
			while ((getline l < pf) > 0) print l
		}
	' "$starship_cfg" > "$tmp" && cat "$tmp" > "$starship_cfg"

	rm -f "$palfile" "$tmp"
}

set_texture() {
	[ -f "$driftwm_cfg" ] || return 0
	local tmp
	tmp="$(mktemp)"
	awk -v p="$1" '
		/^[[:space:]]*texture[[:space:]]*=/ { print "texture = \"" p "\""; next }
		{ print }
	' "$driftwm_cfg" > "$tmp" && cat "$tmp" > "$driftwm_cfg"
	rm -f "$tmp"
}

restart_waybar() {
	local i
	if systemctl --user is-enabled waybar.service >/dev/null 2>&1; then
		systemctl --user restart waybar.service
		return 0
	fi
	pkill waybar 2>/dev/null || true
	for i in $(seq 1 30); do
		pgrep waybar >/dev/null 2>&1 || break
		sleep 0.05
	done
	pkill -9 waybar 2>/dev/null || true
	setsid waybar >/dev/null 2>&1 < /dev/null &
}

apply() {
	set_texture "$1"
	driftwm msg action reload-config >/dev/null 2>&1 || touch "$driftwm_cfg"
	wal -n -q --saturate 0.4 -i "$1"
	starship_palette
	restart_waybar
	mkdir -p "$(dirname "$state")"
	printf '%s' "$1" > "$state"
}

if [ "${1:-}" = "restore" ]; then
	if [ -f "$state" ]; then
		apply "$(cat "$state")"
	else
		restart_waybar
	fi
	exit 0
fi

file="$(list | menu --lines 6 --width 600 --define image_size=96 --prompt "Wallpaper")"
[ -z "$file" ] && exit 0
file="${file##*:text:}"
[ -f "$dir/$file" ] || exit 1
apply "$dir/$file"
